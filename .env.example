# MySQL connection string (hPanel -> Databases)
DATABASE_URL=mysql://user:password@host:3306/proof_of_tooling
# Local development (docker-compose.yml, `npm run db:up`):
# DATABASE_URL=mysql://pot:pot_dev_password@localhost:3307/proof_of_tooling
# Long random string; cron endpoints require "Authorization: Bearer <value>"
CRON_SECRET=change-me-to-a-long-random-string
# RPC endpoint for Solana mainnet (falls back to the public RPC when unset)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-key
# Optional: raises the GitHub API rate limit for repo checks
GITHUB_TOKEN=
# Protects /api/admin/* (moderation, seed). At least 16 characters and different from CRON_SECRET;
# leave unset to keep those endpoints switched off.
ADMIN_SECRET=
# Client IP detection for rate limiting. The first X-Forwarded-For value is never trusted.
# Either name a header your proxy sets with the real client address (e.g. x-real-ip), or set how many
# trusted proxies sit in front of the app (default 1: the rightmost X-Forwarded-For entry is used).
# Requests whose IP cannot be determined share one stricter rate-limit bucket.
TRUSTED_IP_HEADER=
TRUSTED_PROXY_HOPS=1
