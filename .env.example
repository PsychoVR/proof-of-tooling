# MySQL connection string (hPanel -> Databases)
DATABASE_URL=mysql://user:password@host:3306/proof_of_tooling
# Local development (docker-compose.yml, `npm run db:up`):
# DATABASE_URL=mysql://pot:pot_dev_password@localhost:3307/proof_of_tooling
# Long random string; cron endpoints require "Authorization: Bearer <value>"
CRON_SECRET=change-me-to-a-long-random-string
# RPC endpoint for Solana mainnet (falls back to the public RPC when unset)
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your-key
# Optional: raises the GitHub API rate limit for repo checks
GITHUB_TOKEN=
